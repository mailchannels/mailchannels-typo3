{
  "name": "mailchannels/typo3-email-api",
  "description": "Alpha TYPO3 mail transport for the MailChannels Email API",
  "type": "typo3-cms-extension",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "~8.4.0",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "typo3/cms-core": "14.3.10",
    "guzzlehttp/guzzle": "^8.2",
    "guzzlehttp/psr7": "^3.1",
    "symfony/mailer": "^7.4",
    "symfony/mime": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "MailChannels\\Typo3\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "mailchannels_email_api"
    }
  },
  "support": {
    "issues": "https://github.com/mailchannels/mailchannels-typo3/issues"
  }
}
